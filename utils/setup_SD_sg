#!/bin/bash

SCRIPT_SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Require correct user and host
if [[ "$(id -un)" != "bcda1" ]] || [[ "$(hostname)" != "bcpc10-ln.xray.aps.anl.gov" ]]; then
  echo "This script can only be run by user 'bcda1' on host 'bcpc10-ln'."
  exit 1
fi

set -e  # Exit on any error

# Identify every physical disk backing the root filesystem and exclude it.
ROOT_SOURCE=$(findmnt -n -o SOURCE /)
mapfile -t ROOT_DISKS < <(lsblk -s -n -o NAME,TYPE "$ROOT_SOURCE" | while read -r name type; do
  [[ "$type" == "disk" ]] && echo "$name"
done)

echo "System root is on: $ROOT_SOURCE"
if [[ ${#ROOT_DISKS[@]} -gt 0 ]]; then
  echo "Excluded root disk(s): ${ROOT_DISKS[*]}"
else
  echo "Unable to identify the physical root disk; refusing to continue."
  exit 1
fi

# List all /dev/sdX devices excluding disks that back the root filesystem.
echo "Available block devices:"
lsblk -d -o NAME,SIZE,MODEL
echo

mapfile -t CANDIDATES < <(lsblk -ndo NAME | grep -E '^sd' | while read -r name; do
  if [[ ! " ${ROOT_DISKS[*]} " =~ " $name " ]]; then
    echo "$name"
  fi
done)

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
  echo "No candidate SD card devices found."
  exit 1
fi

echo "Detected candidate devices:"
for dev in "${CANDIDATES[@]}"; do
  echo "  /dev/$dev"
done

read -rp "Enter the device name of the SD card (e.g., sdb): " SDDEV

VALID_DEVICE=false
for candidate in "${CANDIDATES[@]}"; do
  if [[ "$SDDEV" == "$candidate" ]]; then
    VALID_DEVICE=true
    break
  fi
done
if [[ "$VALID_DEVICE" != true || ! -b "/dev/$SDDEV" ]]; then
  echo "Invalid device name or device not found in candidate list."
  exit 1
fi

DEVICE="/dev/$SDDEV"
MNT1="/tmp/mnt/SD1"
MNT2="/tmp/mnt/SD2"

# Refuse to overwrite or hide mounts left behind by an earlier run.
for mountpoint in "$MNT1" "$MNT2"; do
  if mountpoint -q "$mountpoint"; then
    echo "Mount point $mountpoint is already in use; unmount it before continuing."
    exit 1
  fi
done

read -rp "This will ERASE ALL DATA on $DEVICE. Are you sure? [y/N]: " CONFIRM
if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
  echo "Aborted."
  exit 1
fi

echo "Preparing $DEVICE..."

# Unmount every mount of the selected disk or any of its child partitions.
mapfile -t TARGET_DEVICES < <(lsblk -ln -o PATH "$DEVICE")
for target in "${TARGET_DEVICES[@]}"; do
  mapfile -t MOUNTPOINTS < <(findmnt -rn -S "$target" -o TARGET || true)
  for mountpoint in "${MOUNTPOINTS[@]}"; do
    echo "Unmounting $target from $mountpoint..."
    sudo umount "$mountpoint"
  done
done
for target in "${TARGET_DEVICES[@]}"; do
  if findmnt -rn -S "$target" >/dev/null; then
    echo "Unable to unmount every filesystem on $target; refusing to repartition."
    exit 1
  fi
done

# # Build fdisk command script dynamically to delete all existing partitions
