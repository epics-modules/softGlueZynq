  # # Derive IOCSERVER as the directory after /net/, plus suffix
  # IOCSERVER_DIR=$(echo "$IOCDIR" | sed -n 's|^/net/\([^/]*\).*|\1|p')
  # IOCSERVER="${IOCSERVER_DIR}.xray.aps.anl.gov"

  # echo "Generating userConfig..."

  # Call the generator installed beside this script.
  "$SCRIPT_SOURCE_DIR/generate_userConfig" "$MNT1/userConfig"
  echo "userConfig updated successfully."

    # # Use sed to replace export lines in place
    # sed -i \
    #   -e "s|^export MAC=.*|export MAC=$MAC|" \
    #   -e "s|^export HOSTNAME=.*|export HOSTNAME=$HOSTNAME|" \
    #   -e "s|^export IOCSERVER=.*|export IOCSERVER=$IOCSERVER|" \
    #   -e "s|^export IOCLOCAL=.*|export IOCLOCAL=$IOCLOCAL|" \
    #   -e "s|^export IOCDIR=.*|export IOCDIR=$IOCDIR|" \
    #   "$MNT1/userConfig"

  # fi
else
  echo "Skipping userConfig preparation."
fi

if [[ -f "$MNT1/userConfig" ]]; then
  echo "Contents of generated userConfig:"
  echo
  echo "----- START of userConfig -----"
  cat "$MNT1/userConfig"
  echo "------ END of userConfig ------"
  echo
fi

sync

# # Unmount
# echo "Unmounting $MNT1..."
# sudo umount "$MNT1"
# echo "Unmounting $MNT2..."
# sudo umount "$MNT2"

