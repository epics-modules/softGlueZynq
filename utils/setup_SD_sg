# done
# 
# # EXISTING_PARTS=($(lsblk -ln -o NAME "$DEVICE" | grep -E "^${SDDEV}[0-9]+" || true))
# # for part in "${EXISTING_PARTS[@]}"; do
# #   NUM=${part#$SDDEV}
# #   FDISK_CMDS+="d\n$NUM\n"
# # done
# 
# # Append partition creation commands
# FDISK_CMDS+="n\np\n1\n2048\n21111221\n"
# FDISK_CMDS+="n\np\n2\n21111222\n\n"
# FDISK_CMDS+="w\n"

FDISK_CMDS=$(cat <<EOF
o
n
p
1
2048
21111221
n
p
2
21111222

w
EOF
)

# Run fdisk with the generated input
echo -e "$FDISK_CMDS" | sudo fdisk "$DEVICE"

# Notify the kernel and wait for the new partition devices.
sudo partprobe "$DEVICE"
sudo udevadm settle
for part in "${DEVICE}1" "${DEVICE}2"; do
  for _ in {1..20}; do
    [[ -b "$part" ]] && break
    sleep 0.25
  done
  if [[ ! -b "$part" ]]; then
    echo "Partition device $part did not appear; refusing to format."
    exit 1
  fi
done

# Format new partitions
sudo mkfs -t vfat "${DEVICE}1"
sudo mkfs -t ext4 -F "${DEVICE}2"

# Create mount points
sudo mkdir -p "$MNT1" "$MNT2"

# Mount with proper permissions
sudo mount -o uid=$(id -u),gid=$(id -g) "${DEVICE}1" "$MNT1"
sudo mount "${DEVICE}2" "$MNT2"

# Prompt for file copy
read -p "Do you want to copy files to the SD card? [y/N]: " COPY_CONFIRM
COPY_CONFIRM=${COPY_CONFIRM,,}

if [[ "$COPY_CONFIRM" == "y" || "$COPY_CONFIRM" == "yes" ]]; then
  DEFAULT_SRC="$SCRIPT_SOURCE_DIR/../bootFiles/BCDALAB_r64"
  read -e -p "Enter source file path or press enter [default: $DEFAULT_SRC]: " SRC_PATH
  SRC_PATH="${SRC_PATH:-$DEFAULT_SRC}"

  FILES=("BOOT.BIN" "boot.scr" "image.ub" "rootfs.tar.gz" "system.dtb")
  # FILES=("BOOT.BIN" "boot.scr" "image.ub" "system.dtb")

  for FILE in "${FILES[@]}"; do
    SRC_FILE="$SRC_PATH/$FILE"
    if [[ -f "$SRC_FILE" ]]; then
	  echo "Copying $FILE..."
      cp "$SRC_FILE" "$MNT1"
    else
      echo "Warning: $FILE not found in $SRC_PATH — skipping"
    fi
  done

  read -e -p "Enter the Vivado project directory: " VIVADO_DIR
  if [[ ! -d "$VIVADO_DIR" ]]; then
    echo "Error: Vivado project directory '$VIVADO_DIR' does not exist."
    exit 1
  fi
  VIVADO_DIR="$(realpath "$VIVADO_DIR")"
  printf 'VIVADO_PROJECT_DIR=%s\n' "$VIVADO_DIR" > "$MNT1/hardware-build"

  if [[ -f "$MNT1/rootfs.tar.gz" ]]; then
    echo "Extracting rootfs.tar.gz..."
    sudo tar xf "$MNT1/rootfs.tar.gz" -C "$MNT2"
  else
    echo "Warning: rootfs.tar.gz not found in $MNT1 — skipping extraction"
  fi
else
  echo "Skipping file copy."
fi

# userConfig
read -p "Do you want to generate userConfig file? [y/N]: " USERCFG_CONFIRM
USERCFG_CONFIRM=${USERCFG_CONFIRM,,}

if [[ "$USERCFG_CONFIRM" == "y" || "$USERCFG_CONFIRM" == "yes" ]]; then
  # USERCFG_SRC="$SRC_PATH/userConfig"
  # if [[ ! -f "$USERCFG_SRC" ]]; then
  #   echo "Error: userConfig file not found at $USERCFG_SRC. Skipping."
  # else
  #   echo "Copying userConfig to SD card..."
   # cp "$USERCFG_SRC" "$MNT1/userConfig"

  # # Prompt for variables
